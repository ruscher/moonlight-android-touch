<?xml version="1.0" encoding="utf-8"?>
<!-- Computers (home). Header with the brand and actions, then the computer cards or,
     while none is known, a friendly empty state. One layout for every orientation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".PcView">

    <LinearLayout
        style="@style/Brp.Header"
        android:preferKeepClear="true">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/brp_logo"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/Brp.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/brp_brand_title" />

            <TextView
                style="@style/Brp.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brp_brand_subtitle" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/manuallyAddPc"
            style="@style/Brp.IconButton"
            android:nextFocusRight="@+id/helpButton"
            android:contentDescription="@string/brp_add_computer"
            android:tooltipText="@string/brp_add_computer"
            android:src="@drawable/ic_add" />

        <ImageButton
            android:id="@+id/helpButton"
            style="@style/Brp.IconButton"
            android:nextFocusRight="@+id/settingsButton"
            android:contentDescription="@string/brp_how_to_connect"
            android:tooltipText="@string/brp_how_to_connect"
            android:src="@drawable/ic_help" />

        <ImageButton
            android:id="@+id/settingsButton"
            style="@style/Brp.IconButton"
            android:contentDescription="@string/brp_settings"
            android:tooltipText="@string/brp_settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <TextView
        android:id="@+id/pcSectionTitle"
        android:accessibilityHeading="true"
        style="@style/Brp.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/brp_section_computers" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The computer grid (AdapterFragment) is placed here -->
        <FrameLayout
            android:id="@+id/pcFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Empty state, above the (empty) grid so its buttons receive touches -->
        <ScrollView
            android:id="@+id/no_pc_found_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="@dimen/brp_content_side_padding"
                android:paddingEnd="@dimen/brp_content_side_padding"
                android:paddingTop="8dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/brp_card"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ProgressBar
                            android:id="@+id/pcs_loading"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:indeterminate="true"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:accessibilityHeading="true"
                            android:accessibilityLiveRegion="polite"
                            android:text="@string/brp_empty_title"
                            android:textColor="@color/brp_text"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingMultiplier="1.15"
                        android:text="@string/brp_empty_body"
                        android:textColor="@color/brp_text_secondary"
                        android:textSize="15sp" />

                    <!-- Two equal buttons; baselineAligned off so a label that wraps
                         (narrow phones, larger fonts, longer languages) grows the
                         button instead of pushing it down and clipping it. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/emptyHowToConnect"
                            style="@style/Brp.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_gravity="center_vertical"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/brp_how_to_connect" />

                        <Button
                            android:id="@+id/emptyAddComputer"
                            style="@style/Brp.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="8dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/brp_add_computer" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</LinearLayout>
