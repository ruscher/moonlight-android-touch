<?xml version="1.0" encoding="utf-8"?>
<GridView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragmentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:numColumns="auto_fit"
    android:columnWidth="@dimen/brp_pc_column_width"
    android:stretchMode="columnWidth"
    android:horizontalSpacing="@dimen/brp_grid_spacing"
    android:verticalSpacing="@dimen/brp_grid_spacing"
    android:paddingStart="@dimen/brp_page_padding"
    android:paddingEnd="@dimen/brp_page_padding"
    android:paddingTop="4dp"
    android:paddingBottom="@dimen/brp_page_padding"
    android:scrollbarStyle="outsideOverlay"
    android:listSelector="@drawable/brp_grid_selector"
    android:drawSelectorOnTop="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:nextFocusUp="@id/manuallyAddPc"
    android:clipToPadding="false"
    android:gravity="center"/>
