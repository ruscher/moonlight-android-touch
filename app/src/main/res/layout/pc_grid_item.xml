<?xml version="1.0" encoding="utf-8"?>
<!-- A computer card: icon chip, name, and its state in words (Online · Paired, ...).
     Ids used by GenericGridAdapter/PcGridAdapter: grid_image_layout, grid_image,
     grid_overlay, grid_spinner, grid_text, grid_status, grid_status_dot. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="88dp"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/brp_card"
    android:padding="16dp">

    <FrameLayout
        android:id="@+id/grid_image_layout"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/brp_chip"
        android:backgroundTint="@color/brp_chip">

        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:tint="@color/brp_accent_text" />

        <ProgressBar
            android:id="@+id/grid_spinner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:indeterminate="true"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="1dp"
            android:background="@drawable/brp_dot"
            android:backgroundTint="@color/brp_surface"
            android:padding="4dp"
            android:importantForAccessibility="no"
            android:tint="@color/brp_text_secondary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/grid_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/brp_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/grid_status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/brp_dot" />

            <TextView
                android:id="@+id/grid_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:maxLines="2"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
