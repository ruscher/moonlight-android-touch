<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable Big Remote Play view styles (BRP-UI.md) -->
<resources>
    <!-- Namespace for the Big Remote Play styles below -->
    <style name="Brp" />

    <style name="Brp.Header">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:baselineAligned">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/brp_page_padding</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Brp.Title">
        <item name="android:textColor">@color/brp_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Brp.Subtitle">
        <item name="android:textColor">@color/brp_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Brp.SectionTitle">
        <item name="android:textColor">@color/brp_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/brp_page_padding</item>
        <item name="android:paddingEnd">@dimen/brp_page_padding</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Brp.IconButton">
        <item name="android:layout_width">@dimen/brp_touch_target</item>
        <item name="android:layout_height">@dimen/brp_touch_target</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:background">@drawable/brp_icon_button</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/brp_text</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Brp.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/brp_touch_target</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Brp.Button.Primary">
        <item name="android:background">@drawable/brp_button_primary</item>
        <item name="android:textColor">@color/brp_on_primary</item>
    </style>

    <style name="Brp.Button.Secondary">
        <item name="android:background">@drawable/brp_button_secondary</item>
        <item name="android:textColor">@color/brp_text</item>
    </style>
</resources>
