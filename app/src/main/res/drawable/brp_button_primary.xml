<?xml version="1.0" encoding="utf-8"?>
<!-- The one suggested action of a state: strong violet, white text (5.1:1), focus ring -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/brp_on_primary_ripple">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/brp_radius_button" />
                    <solid android:color="@color/brp_chip_neutral" />
                </shape>
            </item>
            <item android:state_focused="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="@dimen/brp_radius_button" />
                            <solid android:color="@color/brp_primary" />
                            <stroke android:width="@dimen/brp_focus_ring" android:color="@color/brp_focus" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/brp_radius_button" />
                    <solid android:color="@color/brp_primary" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
