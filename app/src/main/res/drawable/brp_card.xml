<?xml version="1.0" encoding="utf-8"?>
<!-- A card: the surface colour, a hairline outline, 16dp corners, ripple on press.
     Keyboard/D-pad focus is drawn by the grid's selector (brp_grid_selector). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/brp_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/brp_radius_card" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/brp_radius_card" />
            <solid android:color="@color/brp_surface" />
            <stroke android:width="1dp" android:color="@color/brp_outline" />
        </shape>
    </item>
</ripple>
